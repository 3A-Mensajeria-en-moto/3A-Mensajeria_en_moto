{
  "realm": "mensajeria",
  "displayName": "Mensajería de Barrio",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "verifyEmail": true,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "bruteForceProtected": true,
  "internationalizationEnabled": true,
  "supportedLocales": ["es", "en"],
  "defaultLocale": "es",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 28800,
  "ssoSessionMaxLifespan": 36000,
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "no-reply@mensajeria.local",
    "fromDisplayName": "Mensajería de Barrio",
    "auth": "false",
    "ssl": "false",
    "starttls": "false"
  },
  "roles": {
    "realm": [
      { "name": "CLIENTE", "description": "Crea envíos y consulta su estado." },
      { "name": "OPERADOR", "description": "Asigna envíos a cadetes." },
      { "name": "CADETE", "description": "Actualiza el estado de los envíos que tiene asignados." },
      { "name": "offline_access", "description": "${role_offline-access}" },
      { "name": "uma_authorization", "description": "${role_uma_authorization}" },
      {
        "name": "default-roles-mensajeria",
        "description": "Roles que recibe todo usuario nuevo (incluye CLIENTE).",
        "composite": true,
        "composites": { "realm": ["offline_access", "uma_authorization", "CLIENTE"] }
      }
    ]
  },
  "defaultRole": { "name": "default-roles-mensajeria" },
  "clients": [
    {
      "clientId": "mensajeria-frontend",
      "name": "Mensajería de Barrio (web)",
      "description": "SPA pública: Authorization Code + PKCE, sin secreto.",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "rootUrl": "http://localhost:3000",
      "baseUrl": "/",
      "redirectUris": ["http://localhost:3000/*"],
      "webOrigins": ["http://localhost:3000"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*"
      },
      "defaultClientScopes": ["web-origins", "acr", "profile", "roles", "email", "basic"],
      "optionalClientScopes": ["offline_access"],
      "protocolMappers": [
        {
          "name": "audiencia-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "mensajeria-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "mensajeria-k6",
      "name": "Pruebas de carga (k6) - SOLO DESARROLLO",
      "description": "Permite pedir tokens con usuario y contraseña (password grant) para los scripts de k6, sin navegador. No usar ni habilitar en producción.",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "defaultClientScopes": ["web-origins", "acr", "profile", "roles", "email", "basic"],
      "protocolMappers": [
        {
          "name": "audiencia-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "mensajeria-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "operador@mensajeria.com",
      "email": "operador@mensajeria.com",
      "firstName": "Operador",
      "lastName": "Central",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "secreto123", "temporary": false }],
      "realmRoles": ["default-roles-mensajeria", "OPERADOR"]
    },
    {
      "username": "contacto@estudioperez.com",

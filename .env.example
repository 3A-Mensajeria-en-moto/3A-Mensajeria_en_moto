# Para correr el backend fuera de Docker (npm run start:dev). Copiar a .env y ajustar.
# Con docker-compose no hace falta: las variables están en docker-compose.yml.
PORT=8080
DB_PATH=data/mensajeria.sqlite

# Keycloak (OIDC). Con `docker compose up keycloak mailpit` estos valores ya sirven.
# KEYCLOAK_ISSUER: "iss" de los tokens = URL pública del realm.
# KEYCLOAK_JWKS_URL: de dónde bajar las claves públicas (vacío = ${KEYCLOAK_ISSUER}/protocol/openid-connect/certs).
# KEYCLOAK_AUDIENCE: "aud" que deben traer los tokens (lo agrega el mapper del cliente mensajeria-frontend).
KEYCLOAK_ISSUER=http://localhost:8180/realms/mensajeria
KEYCLOAK_JWKS_URL=
KEYCLOAK_AUDIENCE=mensajeria-api

# Orígenes permitidos por CORS (separados por coma). Vacío = cualquiera.
CORS_ORIGIN=http://localhost:3000

# Mail: si SMTP_HOST está vacío, los mails se escriben en el log (modo desarrollo).
# Para usar Mailpit del compose desde afuera de Docker, publicar su puerto 1025 y poner SMTP_HOST=localhost.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Mensajería de Barrio <no-reply@mensajeria.example.com>

# Carga de perfiles de ejemplo al iniciar si la base está vacía (las cuentas están en el realm de Keycloak)
SEED_DEMO=true
